# ==============================================================================
# EduNexa VPS Production Environment (.env)
# Optimized for Ubuntu 22.04 LTS (1 vCPU, 4 GB RAM) with Host Nginx & Cloudflare
# ==============================================================================

# VPS Local Port for Host Nginx reverse proxy (Default: 8002)
PORT=8002

# The domain/subdomain pointed to your VPS via Cloudflare DNS A record
SITE_DOMAIN=edunexa.sandeepwebsolutions.in
SITE_URL=https://edunexa.sandeepwebsolutions.in
ALLOWED_HOSTS=edunexa.sandeepwebsolutions.in,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://edunexa.sandeepwebsolutions.in

# Reverse proxy SSL header trust (Required for Nginx -> Gunicorn HTTPS recognition)
TRUST_PROXY=1

# Generate strong secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(60))"
# Must be at least 50 characters long:
DJANGO_SECRET_KEY=
# Database password for PostgreSQL:
POSTGRES_PASSWORD=

# Demo Mode:
# Set DEMO_MODE=1 for evaluation/presentation (one-click role logins, test payments, demo banner, mock email)
# Set DEMO_MODE=0 for production use with real users and real emails
DEMO_MODE=1

# Email configuration (Required if DEMO_MODE=0; optional if DEMO_MODE=1)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=EduNexa <noreply@edunexa.sandeepwebsolutions.in>
ERROR_EMAILS=

# Concurrency tuning for 1 vCPU / 4 GB RAM VPS
WEB_CONCURRENCY=2
WORKER_CONCURRENCY=1

# Razorpay Test Keys (Optional, without them sandbox simulated checkout is used)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# The AI assistant (Google Gemini, docs/adr/0015-ai-assistant.md). Leave empty to switch it off.
# Questions, and the records needed to answer them, are sent to Google.
GEMINI_API_KEY=
ASSISTANT_MODEL=gemini-3.5-flash-lite

# Retention policies
LEAVER_GRACE_DAYS=30
LEAVER_FEES_GRACE_DAYS=90
